# ========================================================
# Let's Track It — Backend Environment Configuration
# ========================================================

# Server Runtime Settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1

# XAMPP MariaDB / MySQL Configuration
# (Standard XAMPP default is host: localhost, port: 3306, user: root, password: "")
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=letstrackit

# Supabase Authentication
# Retrieve these credentials from your Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini AI SDK
# Used for RAG embedding generation, natural language ingestion, receipt parsing, and chat
GEMINI_API_KEY=your-gemini-api-key

# Session Security & Rate Limiting
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
