    "@tanstack/react-query": "^5.45.0",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "lets-track-it-monorepo": "file:../..",
    "lucide-react-native": "^0.395.0",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
